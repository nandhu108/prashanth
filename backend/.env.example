# ---------------------------------------------------------------------------
# Prashanth Hospitals - Event Management Platform (Backend)
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/prashanth_events

# Public site (used for absolute URLs in SEO tags, QR codes, share links)
PUBLIC_SITE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Reverse proxies in front of the API whose X-Forwarded-For is trusted.
# 1 = NGINX/docker-compose (default). 2 = Vercel rewrite -> Render.
TRUST_PROXY=1

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8082

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# --- Auth (admin dashboard) ---
# Generate a real secret for anything beyond local dev: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# First superadmin account, created by `npm run seed:admin` (idempotent -
# never overwrites an existing account's password on re-run).
ADMIN_BOOTSTRAP_EMAIL=admin@prashanthhospitals.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
ADMIN_BOOTSTRAP_NAME=Platform Admin

# --- Uploads (Event CMS) ---
UPLOAD_DIR=uploads

# --- Ticketing holds (Registration/Ticketing) ---
TICKET_HOLD_MINUTES=15

# --- Payments (Razorpay) - leave blank until you have test/live keys ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API) - leave blank to no-op sends in dev ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# --- Reserved for later modules ---
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
